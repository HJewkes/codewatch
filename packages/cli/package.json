{
  "name": "@codewatch/cli",
  "version": "0.6.0",
  "description": "Analyze code structure, drift, and architecture from your terminal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codewatch": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./read-api": {
      "import": "./dist/read-api/reader.js",
      "types": "./dist/read-api/reader.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "codewatch",
    "code-analysis",
    "dependency-graph",
    "architecture",
    "static-analysis",
    "code-quality",
    "cli"
  ],
  "author": "Henry Jewkes",
  "license": "MIT",
  "homepage": "https://github.com/HJewkes/codewatch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJewkes/codewatch.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/HJewkes/codewatch/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured yet'"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@titan-design/agent": "^0.4.0",
    "@titan-design/code-graph": "^0.9.0",
    "@titan-design/code-parser": "^0.1.0",
    "@titan-design/embed": "^0.2.0",
    "@titan-design/evidence": "^0.1.0",
    "@titan-design/hitl": "^0.2.1",
    "@titan-design/store-sqlite": "^0.3.1",
    "@titan-design/style-analyzer": "^0.1.0",
    "@titan-design/style-checker": "^0.3.0",
    "@titan-design/style-profile": "^0.1.0",
    "@titan-design/workflow": "^0.4.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "cose-base": "^1.0.3",
    "cytoscape": "^3.30.0",
    "cytoscape-cose-bilkent": "^4.1.0",
    "elkjs": "^0.10.0",
    "layout-base": "^1.0.2",
    "octokit": "^5.0.5",
    "web-tree-sitter": "^0.26.6",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@codewatch/core": "workspace:*",
    "@codewatch/render": "workspace:*",
    "@types/node": "^25.3.2"
  }
}
